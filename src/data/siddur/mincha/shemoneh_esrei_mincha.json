    {
      "kind": "faq",
      "body": [
        {
          "spans": [
            {
              "text": "FAQ: Why am I asking Hashem for stuff? Hashem knows what I want, and He also knows what I really need! If I really need it and am supposed to have it, He would have given it to me!"
            }
          ]
        }
      ]
    },
