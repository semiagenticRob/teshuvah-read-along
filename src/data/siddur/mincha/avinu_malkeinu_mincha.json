      "en": [
        {
          "spans": [
            {
              "text": "Our Father, our King, we have sinned against You."
            }
          ],
          "anchorLine": 0
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, (even though we have messed up, still we accept and publicly proclaim that) we have no King besides You!"
            }
          ],
          "anchorLine": 0
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, (even though we may not be personally deserving, but please) deal kindly with us, for the sake of Your Name (so that we will have the ability to fulfill our mission and sanctify Your Name)."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, initiate for us a good new year."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, bless us with a good year."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, cancel all harsh decrees concerning us (since they will hold us back from fulfilling our mission)."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, cancel the plans of those who hate us."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, defeat the schemes of our enemies."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, destroy all those who attack and oppress us."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, close up the mouths of our adversaries and accusers."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, get rid of all diseases, wars, hunger, captivity, destruction, evildoing, and negative spiritual influences from Your nation."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, keep plagues away from Your heritage."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, forgive and pardon all our sins."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, wipe away and remove from Your sight all the sins we did on purpose, and those we did by mistake."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, with Your great compassion, erase all records of our sins."
            }
          ],
          "anchorLine": 0
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, cause us (help us and motivate us) to return to You with proper teshuvah."
            }
          ],
          "anchorLine": 0
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, send a completely recovery to the members of Your nation who are sick."
            }
          ],
          "anchorLine": 0
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, tear up the evil decree of our judgment."
            }
          ],
          "anchorLine": 0
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, recall the memory of our good deeds."
            }
          ],
          "anchorLine": 0
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, (even if we are not deserving) act with mercy toward us for the sake of those who were murdered al Kiddush Hashem."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, (even if we are not deserving) act with mercy toward us for the sake of those who were slaughtered for proclaiming the Oneness of Hashem (as expressed in the Shema)."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, (even if we are not deserving) act with mercy toward us for the sake of those who went through fire and water al kiddush Hashem."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, let us (live to) see as You avenge the spilled blood of Your servants."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, (even if we are not deserving) act with mercy toward us for Your sake."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, (even if we are not deserving) act with mercy toward us for Your sake—and save us!"
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, (even if we are not deserving) act with mercy toward us because of Your abundant compassion."
            }
          ]
        },
        {
          "spans": [
            {
              "text": "Our Father, our King, (even if we are not deserving) act with mercy toward us for the glory of Your great and awesome Name that the world intuitively knows rests on us, Your people."
            }
          ]
        }
      ],
